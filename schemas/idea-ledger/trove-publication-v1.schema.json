{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idea-ledger.local/schemas/trove-publication-v1.schema.json",
  "title": "Reviewed Trove public publication envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "source", "contentHash", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "reviewId", "reviewedAt", "reviewedBy"],
      "properties": {
        "workspace": { "const": "trove" },
        "reviewId": { "$ref": "#/$defs/nonEmptyString" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewedBy": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["idea", "review"],
        "properties": {
          "idea": { "$ref": "source-v1.schema.json#/$defs/idea" },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "state", "reviewedAt", "reviewedBy"],
            "properties": {
              "id": { "$ref": "#/$defs/nonEmptyString" },
              "state": { "const": "APPROVED" },
              "reviewedAt": { "type": "string", "format": "date-time" },
              "reviewedBy": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
