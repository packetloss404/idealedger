{
  "name": "idea-ledger",
  "version": "1.0.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.2",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "typescript": "~6.0.3",
    "unified": "^11.0.5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "write-file-atomic": "^7.0.1"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "web": "vite",
    "build": "npm run build:web",
    "preview": "vite preview",
    "lint": "eslint src/main.tsx src/router.tsx src/ledger src/web --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ideas:validate": "node scripts/idea-ledger/cli.mjs validate",
    "ideas:generate": "node scripts/idea-ledger/cli.mjs generate",
    "ideas:check": "node scripts/idea-ledger/cli.mjs check",
    "ideas:import-trove": "node scripts/idea-ledger/import-trove.mjs",
    "ideas:test": "node --test scripts/idea-ledger/test/*.test.mjs",
    "mclovin:plan": "node scripts/mclovin/plan.mjs",
    "mclovin:run": "node scripts/mclovin/run.mjs",
    "mclovin:check": "node --check scripts/mclovin/plan.mjs && node --check scripts/mclovin/run.mjs",
    "build:web": "npm run ideas:check && vite build",
    "check:export": "node scripts/idea-ledger/check-export.mjs dist",
    "check": "npm run ideas:validate && npm run ideas:test && npm run ideas:check && npm run mclovin:check && npm run test && npm run typecheck && npm run lint"
  },
  "private": true
}
